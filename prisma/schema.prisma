  updatedAt DateTime       @updatedAt
  events    AlertEvent[]

  @@index([metric])
  @@index([enabled])
}

model AlertEvent {
  id        String         @id @default(cuid())
  ruleId    String
  metric    String
  value     Float
  threshold Float
  channels  AlertChannel[] @default([])
  sentAt    DateTime       @default(now())
  rule      AlertRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([sentAt])
}

model AnalyticsDay {
