  name      String
  condition Json
  severity  String   @default("Warning")
  channels  String[] @default([])
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

model AuditChannel {
  id          String    @id @default(cuid())
  type        String    @unique
  config      Json?
  connected   Boolean   @default(false)
