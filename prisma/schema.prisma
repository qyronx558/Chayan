  createdBy    User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([published])
  @@index([createdAt])
  @@index([categoryId])
  @@index([createdById])
  @@index([moderation])
  @@index([createdById, moderation])
}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  icon        String?
