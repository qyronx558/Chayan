  botShare        Float    @default(0)
  signups         Int      @default(0)
  jobsPublished   Int      @default(0)
  latencyP95      Float?
  errorRate       Float    @default(0)
  requests        Int      @default(0)
  errors          Int      @default(0)
  avgTimeOnPageMs Int?

  @@index([date])
}

model AnalyticsModuleDay {
  id           String   @id @default(cuid())
  date         DateTime
  module       String
  items        Int      @default(0)
  views        Int      @default(0)
  viewsPerItem Float    @default(0)

  @@unique([date, module])
  @@index([module, date])
}

model IntegrationSetting {
  key         String    @id
  connected   Boolean   @default(false)
  config      Json?
  metrics     Json?
  connectedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

model AuditEvent {
  id           String      @id @default(cuid())
  createdAt    DateTime    @default(now())
  action       AuditAction
  entityType   String
  entityId     String
  actorId      String?
  actorRole    String?
  actor        User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  summary      String
  diff         Json?
  source       AuditSource @default(ADMIN_UI)
  ipAddress    String?
  userAgent    String?
  requestId    String?
  flagged      Boolean     @default(false)
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?       @relation("AuditReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  note         String?
  prevHash     String?
  hash         String

  @@index([createdAt])
  @@index([action])
  @@index([entityType])
  @@index([actorId])
  @@index([flagged])
  @@index([createdAt, action])
  @@index([entityType, entityId])
}

model RetentionPolicy {
