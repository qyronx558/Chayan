generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostType {
  JOB
  PRIVATE_JOB
  RESULT
  ADMIT_CARD
  ANSWER_KEY
  SYLLABUS
  ADMISSION
  BLOG
}

enum CommentStatus {
  APPROVED
  PENDING_REVIEW
  DELETED
}

enum CommentKind {
  GENERAL
  QUESTION
  ANSWER
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum JobStatus {
  ACTIVE
  EXPIRED
  UPCOMING
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum RemotePolicy {
  ONSITE
  HYBRID
  REMOTE
}

enum CompanyVerification {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum PrivateAppStatus {
  saved
  applied
  shortlisted
  interview
  offer
  joined
  rejected
  withdrawn
}

enum ReferralStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String                  @unique
  password               String?
  image                  String?
  avatarUrl              String?
  role                   Role                    @default(USER)
  emailVerified          DateTime?
  phone                  String?
  phoneVerifiedAt        DateTime?
  language               String                  @default("English")
  qualification          String?
  dateOfBirth            DateTime?
  preferredStates        String[]                @default([])
  interestedCategories   String[]                @default([])
  twoFactorEnabled       Boolean                 @default(false)
  twoFactorSecret        String?
  passwordChangedAt      DateTime?
  pendingEmail           String?
  emailChangeToken       String?                 @unique
  emailChangeExpiry      DateTime?
  resetToken             String?                 @unique
  resetTokenExpiry       DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  bookmark               Bookmark[]
  comments               Comment[]
  commentUpvotes         CommentUpvote[]
  commentFollows         CommentFollow[]
  helpfulCount           Int                     @default(0)
  log                    Log[]
  notificationPreference NotificationPreference?
  userNotification       UserNotification[]
  resume                 Resume?
  accounts               Account[]
  sessions               Session[]
  jobs                   Job[]
  privateJobs            PrivateJob[]
  results                Result[]
  admitCards             AdmitCard[]
  answerKeys             AnswerKey[]
  admissions             Admission[]
  syllabi                Syllabus[]
  departments            Department[]
  blogPosts              BlogPost[]
  applications           Application[]
  reminderLogs           ReminderLog[]
  privateApplications    PrivateApplication[]
  companyMembers         CompanyMember[]
  jobReferrals           JobReferral[]
  jobReports             JobReport[]
  companyOtpChallenges   CompanyOtpChallenge[]
  referralCode           EmployerReferralCode?
  referralsMade          EmployerReferral[]      @relation("Referrer")
  referralsReceived      EmployerReferral[]      @relation("Referred")
  coinLedger             CoinLedger[]
  rewardEnrollments      RewardEnrollment[]
  payoutAccount          PayoutAccount?
  payoutRequests         PayoutRequest[]
  auditEvents            AuditEvent[]            @relation("AuditActor")
  auditReviews           AuditEvent[]            @relation("AuditReviewer")
  userSessions           UserSession[]
  loginAttempts          LoginAttempt[]
  phoneCodes             PhoneVerificationCode[]

  @@index([email])
  @@index([role])
  @@index([resetToken])
}

model Resume {
  id         String   @id @default(cuid())
  userId     String   @unique
  fileName   String
  fileType   String
  fileSize   Int
  rawText    String
  skills     String?
  education  String?
  experience String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id                      String  @id @default(cuid())
  userId                  String  @unique
  jobAlerts               Boolean @default(true)
  resultAlerts            Boolean @default(true)
  admitCardAlerts         Boolean @default(false)
  privateJobAlerts        Boolean @default(true)
  admissionAlerts         Boolean @default(true)
  blogAlerts              Boolean @default(true)
  syllabusAlerts          Boolean @default(true)
  answerKeyAlerts         Boolean @default(true)
  generalAlerts           Boolean @default(true)
  smsJobAlerts            Boolean @default(false)
  smsResultAlerts         Boolean @default(false)
  smsAdmitCardAlerts      Boolean @default(false)
  smsPrivateJobAlerts     Boolean @default(false)
  smsAdmissionAlerts      Boolean @default(false)
  smsBlogAlerts           Boolean @default(false)
  smsSyllabusAlerts       Boolean @default(false)
  smsAnswerKeyAlerts      Boolean @default(false)
  smsGeneralAlerts        Boolean @default(false)
  telegramJobAlerts       Boolean @default(false)
  telegramResultAlerts    Boolean @default(false)
  telegramAdmitCardAlerts Boolean @default(false)
  telegramAnswerKeyAlerts Boolean @default(false)
  telegramDeadlineAlerts  Boolean @default(false)
  telegramReviewAlerts    Boolean @default(false)
  telegramRoleAlerts      Boolean @default(false)
  telegramSecurityAlerts  Boolean @default(false)
  emailDeadlineAlerts     Boolean @default(true)
  smsDeadlineAlerts       Boolean @default(false)
  emailReviewAlerts       Boolean @default(true)
  smsReviewAlerts         Boolean @default(false)
  emailRoleAlerts         Boolean @default(true)
  smsRoleAlerts           Boolean @default(false)
  emailSecurityAlerts     Boolean @default(true)
  smsSecurityAlerts       Boolean @default(false)
  telegramGeneralAlerts   Boolean @default(false)
  digestFrequency         String  @default("INSTANT")
  quietHoursEnabled       Boolean @default(false)
  phoneVerified           Boolean @default(false)
  user                    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  device       String   @default("Unknown device")
  ip           String?
  userAgent    String?
  location     String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, lastActiveAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  success   Boolean  @default(true)
  device    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([createdAt])
}

model PhoneVerificationCode {
  id          String   @id @default(cuid())
  userId      String
  phone       String
  codeHash    String
  expiresAt   DateTime
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model UserNotification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  slug      String
  message   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

model AdminUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model Category {
  id           String         @id @default(cuid())
  name         String         @unique
  slug         String         @unique
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  job          Job[]
  result       Result[]
  admitCard    AdmitCard[]
  answerKey    AnswerKey[]
  admission    Admission[]
  syllabus     Syllabus[]
  notification Notification[]
  exam         Exam[]

  @@index([name])
  @@index([slug])
}

model Department {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  description String?
  createdAt   DateTime    @default(now())
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  job         Job[]
  result      Result[]
  admitCard   AdmitCard[]
  answerKey   AnswerKey[]
  admission   Admission[]
  syllabus    Syllabus[]

  @@index([name])
  @@index([slug])
  @@index([createdById])
}

/// Who may apply for a government job: anyone in India, one state, or one district.
enum JobLevel {
  CENTRAL  @map("central")
  STATE    @map("state")
  DISTRICT @map("district")
}

enum StateType {
  STATE           @map("state")
  UNION_TERRITORY @map("union_territory")
}

model State {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  type      StateType  @default(STATE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  job       Job[]
  districts District[]

  @@index([name])
  @@index([slug])
  @@index([type])
}

/// District names/slugs are unique within a state only (e.g. Bilaspur exists in CG and HP).
model District {
  id        String   @id @default(cuid())
  name      String
  slug      String
  stateId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  state     State    @relation(fields: [stateId], references: [id], onDelete: Restrict)
  jobs      Job[]

  @@unique([stateId, slug])
  @@unique([stateId, name])
  @@index([stateId])
  @@index([slug])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
}

model Job {
  id                   String           @id @default(cuid())
  title                String
  slug                 String           @unique
  departmentId         String
  categoryId           String
  stateId              String?
  jobLevel             JobLevel         @default(CENTRAL)
  districtId           String?
  advertisementNo      String?
  totalVacancies       Int?
  salary               String?
  location             String?
  ageLimit             String?
  ageRelaxation        String?
  education            String?
  selectionProcess     String?
  applicationFee       String?
  importantDates       Json?
  documentsRequired    String?
  howToApply           String?
  officialNotification String?
  officialWebsite      String?
  applyLink            String?
  status               JobStatus        @default(ACTIVE)
  experience           String?
  startDate            DateTime?
  lastDate             DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  createdById          String?
  moderation           ModerationStatus @default(APPROVED)
  reviewedById         String?
  reviewedAt           DateTime?
  reviewNote           String?
  department           Department       @relation(fields: [departmentId], references: [id])
  category             Category         @relation(fields: [categoryId], references: [id])
  state                State?           @relation(fields: [stateId], references: [id])
  district             District?        @relation(fields: [districtId], references: [id], onDelete: Restrict)
  createdBy            User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  result               Result[]
  admitCard            AdmitCard[]
  answerKey            AnswerKey[]
  syllabus             Syllabus[]
  bookmark             Bookmark[]
  jobView              JobView[]

  @@index([title])
  @@index([slug])
  @@index([status])
  @@index([departmentId])
  @@index([categoryId])
  @@index([stateId])
  @@index([jobLevel])
  @@index([districtId])
  @@index([createdById])
  @@index([moderation])
  @@index([createdById, moderation])
  @@index([lastDate])
  @@index([totalVacancies])
  @@index([createdAt])
}

model Company {
  id               String                @id @default(cuid())
  name             String                @unique
  slug             String                @unique
  logo             String?
  website          String?
  description      String?
  industry         String?
  size             String?
  hq               String?
  verifiedStatus   CompanyVerification   @default(UNVERIFIED)
  claimEmailDomain String?
  responseRate     Int?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @default(now()) @updatedAt
  privateJob       PrivateJob[]
  members          CompanyMember[]
  otpChallenges    CompanyOtpChallenge[]

  @@index([name])
  @@index([slug])
  @@index([verifiedStatus])
}

model PrivateJob {
  id                String               @id @default(cuid())
  title             String
  slug              String               @unique
  companyId         String
  type              JobType
  category          String?
  description       String?
  location          String?
  salary            String?
  salaryMin         Int?
  salaryMax         Int?
  experience        String?
  expMin            Int?
  expMax            Int?
  qualification     String?
  skills            String[]             @default([])
  remotePolicy      RemotePolicy?
  vacancies         Int?
  applicationUrl    String?
  applicationEmail  String?
  lastDate          DateTime?
  status            String               @default("ACTIVE")
  isFresherFriendly Boolean              @default(false)
  isWalkIn          Boolean              @default(false)
  walkInVenue       String?
  walkInDate        DateTime?
  proofUrl          String?
  trustScore        Int                  @default(0)
  views             Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  createdById       String?
  moderation        ModerationStatus     @default(APPROVED)
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNote        String?
  company           Company              @relation(fields: [companyId], references: [id])
  createdBy         User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  bookmark          Bookmark[]
  applications      PrivateApplication[]
  viewsLog          PrivateJobView[]
  reports           JobReport[]
  clicks            JobClick[]

  @@index([title])
  @@index([slug])
  @@index([companyId])
  @@index([type])
  @@index([status])
  @@index([remotePolicy])
  @@index([isFresherFriendly])
  @@index([isWalkIn])
  @@index([salaryMin])
  @@index([trustScore])
  @@index([createdById])
  @@index([moderation])
  @@index([createdById, moderation])
  @@index([category])
  @@index([location])
  @@index([expMin])
  @@index([salaryMax])
  @@index([createdAt])
}

model Result {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  description  String?
  departmentId String
  categoryId   String
  jobId        String?
  pdfUrl       String?
  resultDate   DateTime?
  status       String?
  createdAt    DateTime         @default(now())
  createdById  String?
  moderation   ModerationStatus @default(APPROVED)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  department   Department       @relation(fields: [departmentId], references: [id])
  category     Category         @relation(fields: [categoryId], references: [id])
  job          Job?             @relation(fields: [jobId], references: [id])
  createdBy    User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  bookmark     Bookmark[]

  @@index([title])
  @@index([slug])
  @@index([departmentId])
  @@index([categoryId])
  @@index([jobId])
  @@index([createdById])
  @@index([moderation])
  @@index([createdById, moderation])
  @@index([resultDate])
  @@index([createdAt])
}

model AdmitCard {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  description  String?
  departmentId String
  categoryId   String
  jobId        String?
  examDate     DateTime?
  downloadUrl  String?
  status       String?
  createdAt    DateTime         @default(now())
  createdById  String?
  moderation   ModerationStatus @default(APPROVED)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  department   Department       @relation(fields: [departmentId], references: [id])
  category     Category         @relation(fields: [categoryId], references: [id])
  job          Job?             @relation(fields: [jobId], references: [id])
  createdBy    User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  bookmark     Bookmark[]

  @@index([title])
  @@index([slug])
  @@index([departmentId])
  @@index([categoryId])
  @@index([jobId])
  @@index([createdById])
  @@index([moderation])
  @@index([createdById, moderation])
  @@index([examDate])
  @@index([createdAt])
}

model AnswerKey {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  description  String?
  departmentId String
  categoryId   String
  jobId        String?
  pdfUrl       String?
  status       String?
  createdAt    DateTime         @default(now())
  createdById  String?
  moderation   ModerationStatus @default(APPROVED)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  department   Department       @relation(fields: [departmentId], references: [id])
  category     Category         @relation(fields: [categoryId], references: [id])
  job          Job?             @relation(fields: [jobId], references: [id])
  createdBy    User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([title])
  @@index([slug])
  @@index([departmentId])
  @@index([categoryId])
  @@index([jobId])
  @@index([createdById])
  @@index([moderation])
  @@index([createdById, moderation])
  @@index([createdAt])
}

model Admission {
  id             String           @id @default(cuid())
  title          String
  slug           String           @unique
  description    String?
  departmentId   String
  categoryId     String
  startDate      DateTime?
  lastDate       DateTime?
  applicationFee String?
  pdfUrl         String?
  status         String?
  createdAt      DateTime         @default(now())
  createdById    String?
  moderation     ModerationStatus @default(APPROVED)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  department     Department       @relation(fields: [departmentId], references: [id])
  category       Category         @relation(fields: [categoryId], references: [id])
  createdBy      User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([title])
  @@index([slug])
  @@index([departmentId])
  @@index([categoryId])
  @@index([createdById])
  @@index([moderation])
  @@index([createdById, moderation])
  @@index([lastDate])
  @@index([startDate])
  @@index([createdAt])
}

model Syllabus {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  description  String?
  departmentId String
  categoryId   String
  jobId        String?
  pdfUrl       String?
  subjects     String?
  status       String?
  createdAt    DateTime         @default(now())
  createdById  String?
  moderation   ModerationStatus @default(APPROVED)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  department   Department       @relation(fields: [departmentId], references: [id])
  category     Category         @relation(fields: [categoryId], references: [id])
  job          Job?             @relation(fields: [jobId], references: [id])
  createdBy    User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  bookmark     Bookmark[]

  @@index([title])
  @@index([slug])
  @@index([departmentId])
  @@index([categoryId])
  @@index([jobId])
  @@index([createdById])
  @@index([moderation])
  @@index([createdById, moderation])
  @@index([createdAt])
}

model Notification {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String?
  categoryId  String
  type        String?
  officialUrl String?
  isTrending  Boolean  @default(false)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  category    Category @relation(fields: [categoryId], references: [id])

  @@index([title])
  @@index([slug])
  @@index([categoryId])
  @@index([isTrending])
}

model Exam {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  categoryId  String
  createdAt   DateTime @default(now())
  category    Category @relation(fields: [categoryId], references: [id])

  @@index([name])
  @@index([slug])
  @@index([categoryId])
}

model Bookmark {
  id           String      @id @default(cuid())
  userId       String
  jobId        String?
  resultId     String?
  admitCardId  String?
  privateJobId String?
  syllabusId   String?
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id])
  job          Job?        @relation(fields: [jobId], references: [id])
  result       Result?     @relation(fields: [resultId], references: [id])
  admitCard    AdmitCard?  @relation(fields: [admitCardId], references: [id])
  privateJob   PrivateJob? @relation(fields: [privateJobId], references: [id])
  syllabus     Syllabus?   @relation(fields: [syllabusId], references: [id])

  @@index([userId])
  @@index([jobId])
  @@index([resultId])
  @@index([admitCardId])
  @@index([privateJobId])
  @@index([syllabusId])
}

enum ApplicationType {
  job
  admission
}

enum ApplicationStatus {
  interested
  applied
  admit_card
  exam_done
  result_out
}

model Application {
  id        String            @id @default(cuid())
  userId    String
  jobId     String
  type      ApplicationType   @default(job)
  status    ApplicationStatus @default(interested)
  appliedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, status])
  @@index([jobId])
}

enum ReminderType {
  application_deadline
  admit_card
  result
}

model ReminderLog {
  id         String       @id @default(cuid())
  userId     String
  jobId      String
  type       ReminderType
  targetDate DateTime
  sentAt     DateTime     @default(now())
  channel    String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId, type, targetDate])
  @@index([userId])
}

model Comment {
  id             String        @id @default(cuid())
  content        String
  imageUrl       String?
  userId         String
  postType       PostType
  postId         String
  parentId       String?
  kind           CommentKind   @default(GENERAL)
  status         CommentStatus @default(APPROVED)
  isPinned       Boolean       @default(false)
  isOfficial     Boolean       @default(false)
  isBestAnswer   Boolean       @default(false)
  isDeleted      Boolean       @default(false)
  reportCount    Int           @default(0)
  upvoteCount    Int           @default(0)
  replyCount     Int           @default(0)
  flaggedReasons String[]      @default([])
  editedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?        @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]       @relation("CommentThread")
  upvotes CommentUpvote[]

  @@index([postType, postId, createdAt])
  @@index([parentId])
  @@index([userId])
  @@index([status])
}

model CommentUpvote {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

