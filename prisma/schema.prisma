enum UserAgentClass {
  human
  search_bot
  unknown_bot
}

enum AuditAction {
  CREATE
  BULK_CREATE
  UPDATE
  APPROVE
  BULK_APPROVE
  REJECT
  DELETE
  BULK_DELETE
  ROLE_CHANGE
  LOG_PURGE
}

enum AuditSource {
  ADMIN_UI
  API
  BULK_IMPORT
  CRAWLER
}

enum HealthStatus {
  ok
  warning
  critical
}

enum AlertChannel {
  Email
  Telegram
}

model PageViewEvent {
  id             String         @id @default(cuid())
  path           String
  entityType     String?
  entityId       String?
  referrer       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  deviceType     String         @default("desktop")
  state          String?
  userAgent      String?
  userAgentClass UserAgentClass @default(human)
  botVerified    Boolean        @default(false)
  hashedIp       String?
  sessionId      String?
  userId         String?
  durationMs     Int?
  createdAt      DateTime       @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([entityType, entityId])
  @@index([sessionId])
  @@index([userId])
  @@index([userAgentClass])
  @@index([state])
}

model SearchQuery {
  id          String   @id @default(cuid())
  term        String
  resultCount Int      @default(0)
