generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostType {
  JOB
  PRIVATE_JOB
  RESULT
  ADMIT_CARD
  ANSWER_KEY
  SYLLABUS
  ADMISSION
  BLOG
}

enum CommentStatus {
  APPROVED
  PENDING_REVIEW
  DELETED
}

enum CommentKind {
  GENERAL
  QUESTION
  ANSWER
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum JobStatus {
  ACTIVE
  EXPIRED
  UPCOMING
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String                  @unique
  password               String?
  image                  String?
  role                   Role                    @default(USER)
  emailVerified          DateTime?
  phone                  String?
  resetToken             String?                 @unique
  resetTokenExpiry       DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  bookmark               Bookmark[]
  comments               Comment[]
  commentUpvotes         CommentUpvote[]
  commentFollows         CommentFollow[]
  helpfulCount           Int                     @default(0)
  log                    Log[]
  notificationPreference NotificationPreference?
  userNotification       UserNotification[]
  resume                 Resume?
  accounts               Account[]
  sessions               Session[]
  jobs                   Job[]
  privateJobs            PrivateJob[]
  results                Result[]
  admitCards             AdmitCard[]
  answerKeys             AnswerKey[]
  admissions             Admission[]
  syllabi                Syllabus[]
  blogPosts              BlogPost[]
  applications           Application[]
  reminderLogs           ReminderLog[]

  @@index([email])
  @@index([role])
  @@index([resetToken])
}

model Resume {
  id         String   @id @default(cuid())
  userId     String   @unique
  fileName   String
  fileType   String
  fileSize   Int
  rawText    String
  skills     String?
  education  String?
  experience String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id               String  @id @default(cuid())
  userId           String  @unique
  jobAlerts        Boolean @default(true)
  resultAlerts     Boolean @default(true)
  admitCardAlerts  Boolean @default(false)
  privateJobAlerts Boolean @default(true)
  admissionAlerts  Boolean @default(true)
  blogAlerts       Boolean @default(true)
  syllabusAlerts   Boolean @default(true)
  answerKeyAlerts  Boolean @default(true)
  generalAlerts    Boolean @default(true)
  smsJobAlerts     Boolean @default(false)
  smsResultAlerts  Boolean @default(false)
  smsAdmitCardAlerts Boolean @default(false)
  smsPrivateJobAlerts Boolean @default(false)
  smsAdmissionAlerts Boolean @default(false)
  smsBlogAlerts    Boolean @default(false)
  smsSyllabusAlerts Boolean @default(false)
  smsAnswerKeyAlerts Boolean @default(false)
  smsGeneralAlerts Boolean @default(false)
  phoneVerified    Boolean @default(false)
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserNotification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  slug      String
  message   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

model AdminUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model Category {
  id           String         @id @default(cuid())
  name         String         @unique
  slug         String         @unique
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  job          Job[]
  result       Result[]
  admitCard    AdmitCard[]
  answerKey    AnswerKey[]
  admission    Admission[]
  syllabus     Syllabus[]
  notification Notification[]
  exam         Exam[]

  @@index([name])
  @@index([slug])
}

model Department {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  description String?
  createdAt   DateTime    @default(now())
  job         Job[]
  result      Result[]
  admitCard   AdmitCard[]
  answerKey   AnswerKey[]
  admission   Admission[]
  syllabus    Syllabus[]

  @@index([name])
  @@index([slug])
}

model State {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  job       Job[]

  @@index([name])
  @@index([slug])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
}

model Job {
  id                   String      @id @default(cuid())
  title                String
  slug                 String      @unique
  departmentId         String
  categoryId           String
  stateId              String?
  advertisementNo      String?
  totalVacancies       Int?
  salary               String?
  location             String?
  ageLimit             String?
  ageRelaxation        String?
  education            String?
  selectionProcess     String?
  applicationFee       String?
  importantDates       Json?
  documentsRequired    String?
  howToApply           String?
  officialNotification String?
  officialWebsite      String?
  applyLink            String?
  status               JobStatus   @default(ACTIVE)
  experience           String?
  startDate            DateTime?
  lastDate             DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  createdById          String?
  moderation           ModerationStatus @default(APPROVED)
  reviewedById         String?
  reviewedAt           DateTime?
  reviewNote           String?
  department           Department  @relation(fields: [departmentId], references: [id])
  category             Category    @relation(fields: [categoryId], references: [id])
  state                State?      @relation(fields: [stateId], references: [id])
  createdBy            User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  result               Result[]
  admitCard            AdmitCard[]
  answerKey            AnswerKey[]
  syllabus             Syllabus[]
  bookmark             Bookmark[]
  jobView              JobView[]

  @@index([title])
  @@index([slug])
  @@index([status])
  @@index([departmentId])
  @@index([categoryId])
  @@index([stateId])
  @@index([createdById])
  @@index([moderation])
  @@index([createdById, moderation])
}

model Company {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  logo        String?
  website     String?
  description String?
  createdAt   DateTime     @default(now())
  privateJob  PrivateJob[]

  @@index([name])
  @@index([slug])
}

model PrivateJob {
  id               String     @id @default(cuid())
  title            String
  slug             String     @unique
  companyId        String
  type             JobType
  category         String?
  description      String?
  location         String?
  salary           String?
  experience       String?
  applicationUrl   String?
  applicationEmail String?
  lastDate         DateTime?
  status           String     @default("ACTIVE")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  createdById      String?
  moderation       ModerationStatus @default(APPROVED)
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  company          Company    @relation(fields: [companyId], references: [id])
  createdBy        User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  bookmark         Bookmark[]

  @@index([title])
  @@index([slug])
  @@index([companyId])
  @@index([type])
  @@index([status])
  @@index([createdById])
  @@index([moderation])
  @@index([createdById, moderation])
}

model Result {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  description  String?
  departmentId String
  categoryId   String
  jobId        String?
  pdfUrl       String?
  resultDate   DateTime?
  status       String?
  createdAt    DateTime @default(now())
  createdById  String?
  moderation   ModerationStatus @default(APPROVED)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  department   Department @relation(fields: [departmentId], references: [id])
  category     Category   @relation(fields: [categoryId], references: [id])
  job          Job?       @relation(fields: [jobId], references: [id])
  createdBy    User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
   bookmark     Bookmark[]

  @@index([title])
  @@index([slug])
  @@index([departmentId])
  @@index([categoryId])
  @@index([jobId])
  @@index([createdById])
  @@index([moderation])
  @@index([createdById, moderation])
}

model AdmitCard {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  description  String?
  departmentId String
  categoryId   String
  jobId        String?
  examDate     DateTime?
  downloadUrl  String?
  status       String?
  createdAt    DateTime @default(now())
  createdById  String?
  moderation   ModerationStatus @default(APPROVED)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  department   Department @relation(fields: [departmentId], references: [id])
  category     Category   @relation(fields: [categoryId], references: [id])
  job          Job?       @relation(fields: [jobId], references: [id])
  createdBy    User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  bookmark     Bookmark[]

  @@index([title])
  @@index([slug])
  @@index([departmentId])
  @@index([categoryId])
  @@index([jobId])
  @@index([createdById])
  @@index([moderation])
  @@index([createdById, moderation])
}

model AnswerKey {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  description  String?
  departmentId String
  categoryId   String
  jobId        String?
  pdfUrl       String?
  status       String?
  createdAt    DateTime @default(now())
  createdById  String?
  moderation   ModerationStatus @default(APPROVED)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  department   Department @relation(fields: [departmentId], references: [id])
  category     Category   @relation(fields: [categoryId], references: [id])
  job          Job?       @relation(fields: [jobId], references: [id])
  createdBy    User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([title])
  @@index([slug])
  @@index([departmentId])
  @@index([categoryId])
  @@index([jobId])
  @@index([createdById])
  @@index([moderation])
  @@index([createdById, moderation])
}

model Admission {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  description    String?
  departmentId   String
  categoryId     String
  startDate      DateTime?
  lastDate       DateTime?
  applicationFee String?
  pdfUrl       String?
  status       String?
  createdAt    DateTime @default(now())
  createdById  String?
  moderation   ModerationStatus @default(APPROVED)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  department   Department @relation(fields: [departmentId], references: [id])
  category     Category   @relation(fields: [categoryId], references: [id])
  createdBy    User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([title])
  @@index([slug])
  @@index([departmentId])
  @@index([categoryId])
  @@index([createdById])
  @@index([moderation])
  @@index([createdById, moderation])
}

model Syllabus {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  description  String?
  departmentId String
  categoryId   String
  jobId        String?
  pdfUrl       String?
  subjects     String?
  status       String?
  createdAt    DateTime   @default(now())
  createdById  String?
  moderation   ModerationStatus @default(APPROVED)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  department   Department @relation(fields: [departmentId], references: [id])
  category     Category   @relation(fields: [categoryId], references: [id])
  job          Job?       @relation(fields: [jobId], references: [id])
  createdBy    User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  bookmark     Bookmark[]

  @@index([title])
  @@index([slug])
  @@index([departmentId])
  @@index([categoryId])
  @@index([jobId])
  @@index([createdById])
  @@index([moderation])
  @@index([createdById, moderation])
}

model Notification {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String?
  categoryId  String
  type        String?
  officialUrl String?
  isTrending  Boolean  @default(false)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  category    Category @relation(fields: [categoryId], references: [id])

  @@index([title])
  @@index([slug])
  @@index([categoryId])
  @@index([isTrending])
}

model Exam {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  categoryId  String
  createdAt   DateTime @default(now())
  category    Category @relation(fields: [categoryId], references: [id])

  @@index([name])
  @@index([slug])
  @@index([categoryId])
}

model Bookmark {
  id           String      @id @default(cuid())
  userId       String
  jobId        String?
  resultId     String?
  admitCardId  String?
  privateJobId String?
  syllabusId   String?
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id])
  job          Job?        @relation(fields: [jobId], references: [id])
  result       Result?     @relation(fields: [resultId], references: [id])
  admitCard    AdmitCard?  @relation(fields: [admitCardId], references: [id])
  privateJob   PrivateJob? @relation(fields: [privateJobId], references: [id])
  syllabus     Syllabus?   @relation(fields: [syllabusId], references: [id])

  @@index([userId])
  @@index([jobId])
  @@index([resultId])
  @@index([admitCardId])
  @@index([privateJobId])
  @@index([syllabusId])
}

enum ApplicationType {
  job
  admission
}

enum ApplicationStatus {
  interested
  applied
  admit_card
  exam_done
  result_out
}

model Application {
  id        String            @id @default(cuid())
  userId    String
  jobId     String
  type      ApplicationType   @default(job)
  status    ApplicationStatus @default(interested)
  appliedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, status])
  @@index([jobId])
}

enum ReminderType {
  application_deadline
  admit_card
  result
}

model ReminderLog {
  id         String       @id @default(cuid())
  userId     String
  jobId      String
  type       ReminderType
  targetDate DateTime
  sentAt     DateTime     @default(now())
  channel    String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId, type, targetDate])
  @@index([userId])
}

model Comment {
  id             String        @id @default(cuid())
  content        String
  imageUrl       String?
  userId         String
  postType       PostType
  postId         String
  parentId       String?
  kind           CommentKind   @default(GENERAL)
  status         CommentStatus @default(APPROVED)
  isPinned       Boolean       @default(false)
  isOfficial     Boolean       @default(false)
  isBestAnswer   Boolean       @default(false)
  reportCount    Int           @default(0)
  upvoteCount    Int           @default(0)
  replyCount     Int           @default(0)
  flaggedReasons String[]      @default([])
  editedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?        @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]       @relation("CommentThread")
  upvotes CommentUpvote[]

  @@index([postType, postId, createdAt])
  @@index([parentId])
  @@index([userId])
  @@index([status])
}

model CommentUpvote {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
}

model DiscussionThread {
  id           String   @id @default(cuid())
  postType     PostType
  postId       String
  locked       Boolean  @default(false)
  commentCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  follows CommentFollow[]

  @@unique([postType, postId])
}

model CommentFollow {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  createdAt DateTime @default(now())

  thread DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
}

model Log {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  userId    String?
  details   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([email])
}

model NewsletterSend {
  id        String   @id @default(cuid())
  sentDate  DateTime @unique
  sentAt    DateTime @default(now())
  recipients Int     @default(0)
  itemsSent  Int     @default(0)

  @@index([sentDate])
}

model BlogPost {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String?
  content     String?
  author      String        @default("Chayan Team")
  image       String?
  tags        String?
  categoryId  String?
  published   Boolean       @default(false)
  views       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById String?
  moderation  ModerationStatus @default(APPROVED)
  reviewedById String?
  reviewedAt  DateTime?
  reviewNote  String?
  category    BlogCategory? @relation(fields: [categoryId], references: [id])
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([published])
  @@index([createdAt])
  @@index([categoryId])
  @@index([createdById])
  @@index([moderation])
  @@index([createdById, moderation])
}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  icon        String?
  color       String?
  createdAt   DateTime   @default(now())
  posts       BlogPost[]

  @@index([slug])
}

model JobView {
  id    String   @id @default(cuid())
  jobId String
  views Int      @default(0)
  date  DateTime @default(now())
  job   Job      @relation(fields: [jobId], references: [id])

  @@unique([jobId, date])
  @@index([jobId])
  @@index([date])
}

model FeaturedItem {
  id           String    @id @default(cuid())
  title        String
  type         String    @default("OTHER")
  badge        String?
  organization String?
  info         String?
  dateText     String?
  image        String?
  ctaLabel     String    @default("View Details")
  ctaUrl       String?
  linkUrl      String
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  isPinned     Boolean   @default(false)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive])
  @@index([isPinned])
  @@index([sortOrder])
}
