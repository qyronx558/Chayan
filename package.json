{
  "name": "news-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:generate",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=95",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:contact": "vitest run tests/integration/api/contact",
    "test:e2e:contact": "node tests/e2e/contact-ui.mjs",
    "test:e2e:scroll-lock": "node tests/e2e/scroll-lock-ui.mjs",
    "py:lint": "uv run ruff check . && uv run ruff format --check .",
    "py:fix": "uv run ruff check . --fix && uv run ruff format .",
    "py:test": "uv run pytest",
    "fix": "npm run lint:fix && npm run py:fix",
    "check": "npm run db:generate && npm run lint && npm run typecheck && npm run test:coverage && npm run py:lint && npm run py:test",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed:locations": "tsx scripts/seed-locations.ts",
    "ingest": "tsx scripts/ingest/run.ts",
    "ingest:dry": "tsx scripts/ingest/run.ts --dry-run",
    "ingest:discover": "tsx scripts/ingest/discover-districts.ts",
    "ingest:check": "tsx scripts/ingest/check-sources.ts",
    "jobs:discover": "tsx scripts/discover-job-boards.ts",
    "jobs:backfill-geo": "tsx scripts/backfill-job-geo.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
