# ═══════════════════════════════════════════════════════════════
# ChayanJobs - Government Jobs Portal
# Environment Variables Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Never commit the real .env file to git.
# ═══════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local:    postgresql://postgres:postgres@localhost:5432/govjobs?schema=public
# Neon:     postgresql://user:pass@ep-*.us-east-2.aws.neon.tech/govjobs?sslmode=require
# Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/govjobs?schema=public"

# ─── NextAuth (Authentication) ────────────────────────────────
# Generate with: openssl rand -hex 32  (or `npx auth secret`)
AUTH_SECRET="change-me-to-a-random-secret-at-least-32-chars-long"
# Keeps auth working on any host (dev proxy / Vercel / custom domain)
AUTH_TRUST_HOST="true"

# ─── App URL ──────────────────────────────────────────────────
# Public URL of your deployed site. Used for sitemap, RSS, robots.txt, metadata.
# Local:    http://localhost:3000
# Vercel:   https://ChayanJobs.vercel.app
# Custom:   https://ChayanJobs.in
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Which copy of the site this is: local | dev | production.
# Local machines use "local". The deploy workflows set dev / production.
NEXT_PUBLIC_APP_ENV="local"

# ─── Google OAuth (Optional - for Google Sign-In) ─────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
#    (and for production: https://YOUR-DOMAIN/api/auth/callback/google)
# 4. Copy the Client ID and Secret here
# Leave blank to disable Google Sign-In.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Resend (Optional - for transactional emails) ─────────────
# Sign up at https://resend.com → API Keys → Create API Key
# Used for: password reset emails, notifications.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@chayanjobs.com"

# Contact form requires Resend. See docs/contact-production.md for the retry cron.
# Only configure a client IP header overwritten by your trusted ingress proxy.
# Vercel automatically uses x-vercel-forwarded-for. Empty elsewhere = shared cap.
CONTACT_IP_HEADER=""

# ─── Redis (Optional - for caching) ───────────────────────────
# Used for: session caching, rate limiting, job view counters.
REDIS_URL="redis://localhost:6379"

# ─── Google Search Console (Optional - verification) ──────────
# 1. Go to https://search.google.com/search-console
# 2. Add your domain and choose "HTML tag" verification method
# 3. Copy the "content" value from the meta tag and paste here
# Leave blank if not using Search Console yet.
GOOGLE_SEARCH_CONSOLE_ID=""

# ─── Cloudinary (Optional - for image uploads) ────────────────
# Sign up at https://cloudinary.com → Dashboard
# Used for: admin panel image uploads (job notifications, banners).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Google AdSense (for ads) ───────────────────────────────────
# Publisher ID is hardcoded as fallback in src/components/ads/AdSenseScript.tsx.
# Set it here to override without a code change. Auto ads + placements are
# controlled in the AdSense dashboard; EEA/UK consent via Funding Choices.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID="ca-pub-6200474851569598"

# ─── Google Analytics (Optional - for traffic tracking) ─────────
# 1. Go to https://analytics.google.com → Create a new GA4 property
# 2. Copy your Measurement ID (G-XXXXXXXXXX)
# 3. Set it here to enable tracking across the site
# Leave blank to disable Google Analytics.
NEXT_PUBLIC_GA_ID=""

# ─── Careers Google Form (for /careers candidate applications) ───
# 1. Create a Google Form -> Send -> Embed (<>) -> copy iframe src
# 2. Paste embed URL (ends with ?embedded=true) + share URL below
# Example embed: https://docs.google.com/forms/d/e/1FAIp.../viewform?embedded=true
NEXT_PUBLIC_CAREERS_FORM_EMBED_URL=""
NEXT_PUBLIC_CAREERS_FORM_URL=""

# ─── SMS (Optional - for phone verification OTPs) ───────────────
# Without this, OTPs are only printed to the server console and (outside
# production) shown on screen in the profile page for testing.
# Pick ONE provider:
#   console  - log only, no real SMS (default when unset)
#   msg91    - recommended for Indian numbers (https://msg91.com)
#   twilio   - https://twilio.com (E.164 numbers, DLT rules apply in India)
#   generic  - any HTTP SMS API (SMS_API_URL + SMS_API_METHOD + SMS_API_HEADERS)
# After changing, restart the dev server.
SMS_PROVIDER=""
# Msg91: auth key + Flow ID from https://msg91.com (sender defaults to ChayanJobs)
MSG91_AUTH_KEY=""
MSG91_FLOW_ID=""
MSG91_SENDER_ID="ChayanJobs"
# Twilio: from https://console.twilio.com (use a verified sender for India)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# Generic HTTP API (POST JSON { phone, message } by default)
SMS_API_URL=""
SMS_API_METHOD="POST"
SMS_API_HEADERS="{\"Content-Type\": \"application/json\"}"

# ─── Newsletter digest cron (for scheduled job-alert emails) ──────
# Shared secret that authorizes GET /api/cron/newsletter.
# Generate with: openssl rand -hex 32
# Set the SAME value in: Vercel env (CRON_SECRET) + GitHub repo secrets
# (CRON_SECRET) + GitHub secret APP_URL (e.g. https://ChayanJobs.in).
# Scheduler lives in .github/workflows/newsletter-digest.yml.
CRON_SECRET=""

# ─── Content ingest bot (official notices → review queue) ─────────────
# See docs/content-ingest.md. The scraper runs in GitHub Actions
# (.github/workflows/content-ingest.yml) and calls /api/cron/ingest.
# Shared secret for /api/cron/ingest/* (separate from CRON_SECRET).
# Generate with: openssl rand -hex 32. Set the SAME value in Vercel and
# in the GitHub repo secret INGEST_SECRET.
INGEST_SECRET=""
# Publish clean, high-confidence bot posts without a human (default off).
INGEST_AUTO_APPROVE="false"
# Max bot posts auto-published per IST day (steady growth, no bulk dumps).
INGEST_AUTO_APPROVE_DAILY_CAP="60"
INGEST_AUTO_APPROVE_MIN_SCORE="75"
INGEST_AUTO_APPROVE_MIN_CONFIDENCE="0.85"
# Scraper-side only (GitHub secrets / your shell, NOT needed on Vercel):
# GEMINI_API_KEY  - free key from https://aistudio.google.com/apikey
# GEMINI_MODEL    - default gemini-flash-lite-latest (fast on the free tier)
# GROQ_API_KEY    - optional text-only fallback, https://console.groq.com
# INGEST_API_URL  - site that receives posts, e.g. https://ChayanJobs.in
# Admin -> Content bot settings (saved in the database) override the auto-approve
# values above once a super admin saves that page.
# "Run now" button in Admin -> Content bot (optional): fine-grained GitHub token with
# access to this repo and permission "Actions: Read and write".
INGEST_GITHUB_TOKEN=""
# INGEST_GITHUB_REPO      - default qyronx558/Chayan
# INGEST_GITHUB_REF       - branch whose workflow runs, default main
# INGEST_DISPATCH_TARGET  - dev | production (default: production when NEXT_PUBLIC_APP_ENV=production)
